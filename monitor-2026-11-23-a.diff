+def _deliver(text, photo=None, key=""):
+    """Send one alert. If Telegram did not take it (down, refusing, still 429 after the
+    wait), the message is kept in the outbox - saved with the state - and sent again
+    at the start of the next runs. The listing itself stays decided, so it is never
+    judged again and never sent twice. (Before 2026-11-23-a an undelivered message
+    was simply lost: the record already said "sent".)"""
+    _TG_UNSURE["v"] = False
+    photo = photo if SEND_PHOTOS else None
+    ok = tg_send_photo(photo, text) if photo else tg_send_message(text)
+    if ok:
+        return True
+    box = _outbox()
+    if _TG_UNSURE["v"]:
+        log(f"Telegram: {key or 'message'} timed out after sending; it may have arrived, "
+            "so it is not repeated")
+    elif box is not None:
+        box.append({"text": text, "photo": photo, "key": key, "n": 1,
+                    "t": dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds")})
+        log(f"Telegram: {key or 'message'} NOT delivered; kept in the outbox, "
+            "sent again next run")
+    return False
+
+
+def flush_outbox(run_started=None):
+    """Send the messages Telegram did not take on EARLIER runs (oldest first). Called
+    right before the state is saved, so a delivered message leaves the outbox in the
+    same save. Messages that failed during this run wait for the next one."""
+    box = _outbox()
+    if not box:
+        return 0
+    now_ts, keep, sent, tried = time.time(), [], 0, 0
+    for e in list(box):
+        t = _to_epoch(e.get("t"))
+        if run_started is not None and t is not None and t >= run_started:
+            keep.append(e)                 # failed in this run: next run
+            continue
+        if t is not None and now_ts - t > OUTBOX_MAX_DAYS * 86400:
+            log(f"Telegram outbox: gave up on {e.get('key')} (not deliverable for "
+                f"{OUTBOX_MAX_DAYS:g} days)")
+            continue
+        if tried >= OUTBOX_PER_RUN:
+            keep.append(e)
+            continue
+        tried += 1
+        _TG_UNSURE["v"] = False
+        ok = (tg_send_photo(e["photo"], e.get("text", "")) if e.get("photo")
+              else tg_send_message(e.get("text", "")))
+        if ok:
+            sent += 1
+        elif _TG_UNSURE["v"]:
+            log(f"Telegram outbox: {e.get('key')} timed out after sending; not repeated")
+        else:
+            e["n"] = int(e.get("n") or 1) + 1
+            keep.append(e)
+    box[:] = keep
+    log(f"Telegram outbox: delivered {sent} message(s) from earlier runs"
+        + (f"; {len(keep)} still waiting" if keep else ""))
+    return sent
+
