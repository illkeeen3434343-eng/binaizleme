+    for iid, pl in sorted(pend.items(), key=lambda kv: str(kv[1].get("_since", ""))):
+        t = _to_epoch(pl.get("_since"))
+        if t is not None and now_ts - t > TAP_PENDING_DAYS * 86400:
+            pend.pop(iid, None)
