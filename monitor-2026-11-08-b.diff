+def _meta_tags(raw):
+    """{property-or-name: content} for a page's <meta> tags (attribute order free)."""
+    out = {}
+    for tag in re.findall(r"<meta\b[^>]*>", (raw or "")[:300000], re.I):
+        attrs = {k.lower(): html.unescape(v)
+                 for k, v in re.findall(r'([\w:.-]+)\s*=\s*"([^"]*)"', tag)}
+        key = attrs.get("property") or attrs.get("name")
+        if key and "content" in attrs and key not in out:
+            out[key] = attrs["content"]
+    return out
+
+
+def _tap_details(raw):
+    """Price, rooms, area and location of a tap ad from its OWN page, so a message built
+    from the page (recovery) looks like every other message. Verified tap page meta:
+      og:title               "3-otaqlı mənzil, Əhmədli m., 80 m²"
+      product:price:amount   "165000.00"   product:price:currency "AZN"
+    Anything that does not match is simply left out."""
+    meta = _meta_tags(raw)
+    title = meta.get("og:title") or ""
+    if not title:
+        tm = re.search(r"<title>(.*?)</title>", raw or "", re.S)
+        title = html.unescape(tm.group(1)) if tm else ""
+    d = {}
+    rm = re.search(r"(\d+)-otaqlı", title)
+    if rm:
+        d["rooms"] = int(rm.group(1))
+    am = re.search(r"(\d+(?:[.,]\d+)?)\s*m²", title)
+    if am:
+        try:
+            d["area"] = float(am.group(1).replace(",", "."))
+        except ValueError:
+            pass
+    lm = re.search(r"\d+-otaqlı[^,]*,\s*(.+?),\s*[\d.,]+\s*m²", title)
+    if lm:
+        d["location"] = lm.group(1).strip()
+    try:
+        pv = int(float(meta.get("product:price:amount") or 0))
+        if pv > 0:
+            d["price"] = pv
+            d["currency"] = meta.get("product:price:currency") or "AZN"
+    except ValueError:
+        pass
+    return d
 
 
