+def _tap_profile_count_from_html(rendered, scope=None):
+    """Count a seller's ads on their rendered profile page. Returns (count, detail);
+    count None = cannot be trusted.
+
+    Verified 8 Nov 2026 (diag_tap_profile.py): the profile says "6 elan" and lists
+    exactly those 6 ads (seller 6638901: 1 flat, 2 houses, 2 offices, 1 land plot);
+    an empty profile says "0 elan" and lists nothing (22702915). Rules:
+      * more ad links than the profile's own total -> someone else's ads on the page
+        (e.g. a VIP block) -> not trusted
+      * count already >= the limit -> enough to decide, even if the list is partial
+      * whole list visible (links == total) -> exact, may be 0
+      * otherwise (list only partly loaded, count below the limit) -> not trusted"""
+    scope = (scope or TAP_COUNT_SCOPE)
+    if _tap_blocked(rendered):
+        return None, {"why": "blocked"}
+    ads = {}
+    for cat, sub, iid in _TAP_AD_LINK.findall(rendered or ""):
+        ads[iid] = (cat, sub)
+    flats = {i for i, (c, s_) in ads.items() if c == "dasinmaz-emlak" and s_ == "menziller"}
+    prop = {i for i, (c, s_) in ads.items() if c == "dasinmaz-emlak"}
+    text = re.sub(r"\s+", " ", html.unescape(re.sub(r"<[^>]+>", " ", rendered or "")))
+    totals = {int(x) for x in re.findall(r"\b(\d+)\s+elan\b", text)}
+    total = totals.pop() if len(totals) == 1 else None
+    n = len(prop) if scope == "property" else len(flats)
+    detail = {"total": total, "links": len(ads), "flats": len(flats), "property": len(prop),
+              "scope": scope}
+    if total is not None and len(ads) > total:
+        detail["why"] = "foreign ads on the page"
+        return None, detail
+    if n >= TAP_MAX_APARTMENTS:
+        return n, detail
+    if total is not None and len(ads) == total:
+        return n, detail
+    detail["why"] = "list not fully loaded"
+    return None, detail
 
 
