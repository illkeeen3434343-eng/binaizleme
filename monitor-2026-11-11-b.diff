+def _bina_description(raw):
+    """(text, source) of a bina ad's OWN description. og:description is cut after
+    ~150 characters (6058940: "... 3 otaqlı, tam yeni..."), and fee wording often
+    comes at the end, so the full text is looked for in the page's structured data
+    (JSON-LD, embedded JSON "description") and description elements - but only a
+    text that STARTS like og:description is taken, so it is always this ad's own
+    text (never a similar ad, the menu or the footer). Falls back to og:description."""
+    meta = _meta_tags(raw)
+    og = (meta.get("og:description") or "").strip()
+    anchor = az_normalize(re.sub(r"(\.\.\.|…)\s*$", "", og)).strip()[:60]
+    if len(anchor) < 15:
+        return og, "og"
+    cands = []
+    for mm in re.finditer(r'<script[^>]+type="application/ld\+json"[^>]*>(.*?)</script>',
+                          raw, re.S):
+        try:
+            data = json.loads(mm.group(1).strip())
+        except Exception:
+            continue
+        for obj in _iter_dicts(data):
+            v = obj.get("description")
+            if isinstance(v, str):
+                cands.append((v, "ld+json"))
+    for mm in re.finditer(r'"description"\s*:\s*"((?:[^"\\]|\\.){20,})"', raw):
+        try:
+            cands.append((json.loads('"' + mm.group(1) + '"'), "data"))
+        except Exception:
+            pass
+    for mm in re.finditer(r'<(div|p|section|article)\b[^>]*class="[^"]*desc[^"]*"[^>]*>(.*?)</\1>',
+                          raw, re.S):
+        body = re.sub(r"<br\s*/?>", "\n", mm.group(2))
+        cands.append((html.unescape(re.sub(r"<[^>]+>", " ", body)), "html"))
+    best, src = og, "og"
+    for text, where in cands:
+        if az_normalize(text).strip().startswith(anchor) and len(text) > len(best):
+            best, src = text, where
+    return best, src
+
