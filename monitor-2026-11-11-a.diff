+_TAP_USER_GID = re.compile(r"Z2lkOi8vdGFwL1VzZXIv([A-Za-z0-9+/]+=*)")   # base64 "gid://tap/User/"
+
+
+def _tap_seller_id(raw):
+    """(seller_id, how) for a tap ad page; how = "link" | "data" | None.
+    Older pages link the profile: /elanlar?user_id=123. Newer pages build that link
+    with JavaScript and carry the seller only in the embedded page data, e.g. ad
+    49172190 (11 Nov 2026): {"__typename":"User","id":"Z2lkOi8vdGFwL1VzZXIvMjM5NTk4NzU",
+    "legacyId":"23959875"} - the id is base64 of "gid://tap/User/23959875". Without
+    this the bot saw no seller, so neither the "3 or more = agent" rule nor the
+    profile count could run. More than one user in the data = ambiguous = None."""
+    m1 = re.search(r"/elanlar\?user_id=(\d+)", raw or "")
+    if m1:
+        return m1.group(1), "link"
+    ids = set()
+    for tail in _TAP_USER_GID.findall(raw or ""):
+        try:
+            dec = base64.b64decode("Z2lkOi8vdGFwL1VzZXIv" + tail + "=" * (-len(tail) % 4))
+            mm = re.fullmatch(rb"gid://tap/User/(\d+)", dec)
+            if mm:
+                ids.add(mm.group(1).decode())
+        except Exception:
+            pass
+    for mm in re.finditer(r'"__typename"\s*:\s*"User"\s*,\s*"id"\s*:\s*"[^"]*"\s*,'
+                          r'\s*"legacyId"\s*:\s*"(\d+)"', raw or ""):
+        ids.add(mm.group(1))
+    if len(ids) == 1:
+        return ids.pop(), "data"
+    return None, None
 
 
